generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Pengguna {
  id                       String              @id @default(uuid())
  sekolahId                String?             @map("sekolah_id")
  peranId                  String?             @map("peran_id")
  dibuatOleh               String?             @map("dibuat_oleh")
  diperbaruiOleh           String?             @map("diperbarui_oleh")
  dihapusOleh              String?             @map("dihapus_oleh")
  namaPengguna             String              @unique @map("nama_pengguna") @db.VarChar(50)
  email                    String              @unique @db.VarChar(100)
  kataSandi                String              @map("kata_sandi") @db.VarChar(255)
  namaLengkap              String              @map("nama_lengkap") @db.VarChar(100)
  avatar                   String?             @db.VarChar(255)
  nipd                     String?             @db.VarChar(20)
  nip                      String?             @db.VarChar(20)
  nuptk                    String?             @db.VarChar(20)
  nisn                     String?             @unique @db.VarChar(20)
  jenisKelamin             String?             @map("jenis_kelamin") @db.VarChar(10)
  tempatLahir              String?             @map("tempat_lahir") @db.VarChar(50)
  tanggalLahir             DateTime?           @map("tanggal_lahir") @db.Date
  alamat                   String?
  noTelepon                String?             @map("no_telepon_rumah") @db.VarChar(20)
  status                   String?             @db.VarChar(20)
  terakhirLogin            DateTime?           @map("terakhir_login") @db.Timestamp(6)
  kodeOtp                  String?             @map("kode_otp") @db.VarChar(10)
  otpTimeout               DateTime?           @map("otp_timeout") @db.Timestamp(6)
  dibuatPada               DateTime            @default(now()) @map("dibuat_pada") @db.Timestamp(6)
  diperbaruiPada           DateTime            @updatedAt @map("diperbarui_pada") @db.Timestamp(6)
  dihapusPada              DateTime?           @map("dihapus_pada") @db.Timestamp(6)
  alamatDomisili           String?             @map("alamat_domisili")
  alamatKtp                String?             @map("alamat_ktp")
  alamatSesuaiDomisili     Boolean?            @default(true) @map("alamat_sesuai_domisili")
  golongan                 String?             @db.VarChar(50)
  jabatan                  String?             @db.VarChar(100)
  kategoriJabatanId        String?             @map("kategori_jabatan_id")
  kecamatan                String?             @db.VarChar(50)
  kelurahan                String?             @db.VarChar(50)
  kodePos                  String?             @map("kode_pos") @db.VarChar(10)
  kotaKabupaten            String?             @map("kota_kabupaten") @db.VarChar(50)
  namaAyah                 String?             @map("nama_ayah") @db.VarChar(100)
  namaIbu                  String?             @map("nama_ibu") @db.VarChar(100)
  namaWaliPesertaDidik     String?             @map("nama_wali_peserta_didik") @db.VarChar(20)
  nik                      String?             @unique @db.VarChar(20)
  nikAyah                  String?             @map("nik_ayah") @db.VarChar(20)
  nikIbu                   String?             @map("nik_ibu") @db.VarChar(20)
  nis                      String?             @db.VarChar(20)
  noHpAyah                 String?             @map("no_hp_ayah") @db.VarChar(20)
  noHpIbu                  String?             @map("no_hp_ibu") @db.VarChar(20)
  pekerjaanAyah            String?             @map("pekerjaan_ayah") @db.VarChar(50)
  pekerjaanIbu             String?             @map("pekerjaan_ibu") @db.VarChar(50)
  pinFailedAttempts        Int                 @default(0) @map("pin_failed_attempts")
  pinHash                  String?             @map("pin_hash") @db.VarChar(255)
  pinLockedUntil           DateTime?           @map("pin_locked_until") @db.Timestamp(6)
  provinsi                 String?             @db.VarChar(50)
  shiftKerja               String?             @map("shift_kerja") @db.VarChar(20)
  shiftKerjaId             String?             @map("shift_kerja_id")
  yayasanId                String?             @map("yayasan_id")
  absensiSiswa             Absensi[]
  kelasSiswa               AnggotaKelas[]      @relation("SiswaKelas")
  auditLogs                AuditLog[]
  biometrikWajah           BiometrikWajah?
  kelasWali                Kelas[]             @relation("WaliKelas")
  kelasMapelDiajar         KelasMapel[]        @relation("GuruPengajar")
  nilaiSiswa               Nilai[]
  nilaiAkhirMapel          NilaiAkhirMapel[]
  notifikasiDiterima       Notifikasi[]        @relation("PenerimaNotifikasi")
  notifikasiDikirim        Notifikasi[]        @relation("PengirimNotifikasi")
  pelanggaranSiswa         PelanggaranSiswa[]  @relation("SiswaPelanggaran")
  pembayaranDiterima       PembayaranTagihan[] @relation("PenerimaPembayaran")
  pembayaranSiswa          PembayaranTagihan[] @relation("SiswaPembayaran")
  peminjamanDiajukan       PeminjamanAset[]    @relation("PeminjamAset")
  peminjamanDiverifikasi   PeminjamanAset[]    @relation("PetugasSarpras")
  asetDiambil              PeminjamanAset[]    @relation("SiswaPengambilAset")
  asetDikembalikan         PeminjamanAset[]    @relation("SiswaPengembaliAset")
  peminjamanBuku           PeminjamanBuku[]
  pendaftaranPpdb          PendaftaranPpdb[]
  penggajian               Penggajian[]
  kategoriJabatan          KategoriJabatan?    @relation(fields: [kategoriJabatanId], references: [id])
  peran                    Peran?              @relation(fields: [peranId], references: [id])
  sekolah                  Sekolah?            @relation(fields: [sekolahId], references: [id])
  shiftKerjaMaster         ShiftKerja?         @relation(fields: [shiftKerjaId], references: [id])
  yayasan                  Yayasan?            @relation(fields: [yayasanId], references: [id])
  pengumpulanTugasSiswa    PengumpulanTugas[]
  percobaanAsesmen         PercobaanAsesmen[]
  permohonanIzins          PermohonanIzin[]    @relation("GuruPenggantiIzin")
  izinDiajukan             PermohonanIzin[]    @relation("PemohonIzin")
  izinDisetujui            PermohonanIzin[]    @relation("PenyetujuIzin")
  rapot                    Rapot[]
  reviewPengguna           ReviewPengguna?
  sesiKonselingKonselor    SesiKonseling[]     @relation("KonselorKonseling")
  sesiKonselingSiswa       SesiKonseling[]     @relation("SiswaKonseling")
  tabunganSiswa            TabunganSiswa[]     @relation("SiswaTabungan")
  tagihanSiswa             Tagihan[]           @relation("SiswaTagihan")
  transaksiTabunganPetugas TransaksiTabungan[] @relation("PetugasTabungan")

  @@map("pengguna")
}

model Peran {
  id             String      @id @default(uuid())
  dibuatOleh     String?     @map("dibuat_oleh")
  diperbaruiOleh String?     @map("diperbarui_oleh")
  dihapusOleh    String?     @map("dihapus_oleh")
  nama           String      @db.VarChar(50)
  namaTampilan   String      @map("nama_tampilan") @db.VarChar(100)
  deskripsi      String?
  status         String?     @default("aktif") @db.VarChar(20)
  dibuatPada     DateTime    @default(now()) @map("dibuat_pada") @db.Timestamp(6)
  diperbaruiPada DateTime    @updatedAt @map("diperbarui_pada") @db.Timestamp(6)
  dihapusPada    DateTime?   @map("dihapus_pada") @db.Timestamp(6)
  sekolahId      String?     @map("sekolah_id")
  pengguna       Pengguna[]
  sekolah        Sekolah?    @relation(fields: [sekolahId], references: [id], onDelete: Cascade)
  peranIzin      PeranIzin[]

  @@unique([nama, sekolahId])
  @@map("peran")
}

model Izin {
  id             String      @id @default(uuid())
  dibuatOleh     String?     @map("dibuat_oleh")
  diperbaruiOleh String?     @map("diperbarui_oleh")
  dihapusOleh    String?     @map("dihapus_oleh")
  nama           String      @unique @db.VarChar(100)
  modul          String      @db.VarChar(50)
  aksi           String      @db.VarChar(50)
  status         String?     @default("aktif") @db.VarChar(20)
  dibuatPada     DateTime    @default(now()) @map("dibuat_pada") @db.Timestamp(6)
  diperbaruiPada DateTime    @updatedAt @map("diperbarui_pada") @db.Timestamp(6)
  dihapusPada    DateTime?   @map("dihapus_pada") @db.Timestamp(6)
  peranIzin      PeranIzin[]

  @@map("izin")
}

model PeranIzin {
  id             String    @id @default(uuid())
  dibuatOleh     String?   @map("dibuat_oleh")
  diperbaruiOleh String?   @map("diperbarui_oleh")
  dihapusOleh    String?   @map("dihapus_oleh")
  peranId        String    @map("peran_id")
  izinId         String    @map("izin_id")
  dibuatPada     DateTime  @default(now()) @map("dibuat_pada") @db.Timestamp(6)
  diperbaruiPada DateTime  @updatedAt @map("diperbarui_pada") @db.Timestamp(6)
  dihapusPada    DateTime? @map("dihapus_pada") @db.Timestamp(6)
  izin           Izin      @relation(fields: [izinId], references: [id])
  peran          Peran     @relation(fields: [peranId], references: [id])

  @@map("peran_izin")
}

model Sekolah {
  id                  String                @id @default(uuid())
  yayasanId           String?               @map("yayasan_id")
  langgananAktifId    String?               @unique @map("langganan_aktif_id")
  dibuatOleh          String?               @map("dibuat_oleh")
  diperbaruiOleh      String?               @map("diperbarui_oleh")
  dihapusOleh         String?               @map("dihapus_oleh")
  nama                String                @db.VarChar(100)
  subdomain           String                @unique @db.VarChar(50)
  kode                String                @unique @db.VarChar(20)
  alamat              String?
  telepon             String?               @db.VarChar(20)
  email               String?               @db.VarChar(100)
  logoBesarUrl        String?               @map("logo_besar_url") @db.VarChar(255)
  status              String?               @db.VarChar(20)
  konfigurasi         Json?
  dibuatPada          DateTime              @default(now()) @map("dibuat_pada") @db.Timestamp(6)
  diperbaruiPada      DateTime              @updatedAt @map("diperbarui_pada") @db.Timestamp(6)
  dihapusPada         DateTime?             @map("dihapus_pada") @db.Timestamp(6)
  bujur               Decimal?              @db.Decimal(11, 8)
  faviconUrl          String?               @map("favicon_url") @db.VarChar(255)
  jenjang             String?               @db.VarChar(20)
  lintang             Decimal?              @db.Decimal(10, 8)
  logoKecilUrl        String?               @map("logo_kecil_url") @db.VarChar(255)
  metodeAbsensiAktif  String[]              @map("metode_absensi_aktif")
  npsn                String?               @unique @map("npsn") @db.VarChar(50)
  radiusAbsensi       Int?                  @map("radius_absensi")
  absensi             Absensi[]
  akunKas             AkunKas[]
  artikelCms          ArtikelCms[]
  aset                Aset[]
  auditLogs           AuditLog[]
  buku                Buku[]
  gedung              Gedung[]
  gelombangPpdb       GelombangPpdb[]
  halamanCms          HalamanCms[]
  jalurPpdb           JalurPpdb[]
  jurnalKas           JurnalKas[]
  jurusan             Jurusan[]
  kategoriJabatan     KategoriJabatan[]
  kategoriPelanggaran KategoriPelanggaran[]
  kategoriTagihan     KategoriTagihan[]
  kelas               Kelas[]
  langgananSekolah    LanggananSekolah[]    @relation("SekolahLangganan")
  mataPelajaran       MataPelajaran[]
  menuKonfigurasi     MenuKonfigurasi[]
  nilaiAkhirMapel     NilaiAkhirMapel[]
  pelanggaranSiswa    PelanggaranSiswa[]
  pembayaranTagihan   PembayaranTagihan[]
  peminjamanAset      PeminjamanAset[]
  peminjamanBuku      PeminjamanBuku[]
  pendaftaranPpdb     PendaftaranPpdb[]
  pengaturanSistem    PengaturanSistem[]
  pengaturanSpmb      PengaturanSpmb?
  penggajian          Penggajian[]
  pengguna            Pengguna[]
  pengumumanPpdb      PengumumanPpdb[]
  peran               Peran[]
  permohonanIzin      PermohonanIzin[]
  rapot               Rapot[]
  riwayatPembayaran   RiwayatPembayaran[]
  yayasan             Yayasan?              @relation(fields: [yayasanId], references: [id])
  sekolahModul        SekolahModul[]
  sesiKonseling       SesiKonseling[]
  shiftKerja          ShiftKerja[]
  shiftSiswa          ShiftSiswa[]
  tabunganSiswa       TabunganSiswa[]
  tagihan             Tagihan[]
  tahunAjaran         TahunAjaran[]
  tarifJabatan        TarifJabatan[]
  tarifTagihan        TarifTagihan[]
  transaksiTabungan   TransaksiTabungan[]

  @@map("sekolah")
}

model Yayasan {
  id                       String             @id @default(uuid())
  dibuatOleh               String?            @map("dibuat_oleh")
  diperbaruiOleh           String?            @map("diperbarui_oleh")
  dihapusOleh              String?            @map("dihapus_oleh")
  nama                     String             @db.VarChar(100)
  alamat                   String?
  telepon                  String?            @db.VarChar(20)
  email                    String?            @db.VarChar(100)
  status                   String?            @default("aktif") @db.VarChar(20)
  dibuatPada               DateTime           @default(now()) @map("dibuat_pada") @db.Timestamp(6)
  diperbaruiPada           DateTime           @updatedAt @map("diperbarui_pada") @db.Timestamp(6)
  dihapusPada              DateTime?          @map("dihapus_pada") @db.Timestamp(6)
  npyp                     String?            @unique @db.VarChar(50)
  paketId                  String?            @map("paket_id")
  statusLangganan          String?            @map("status_langganan") @db.VarChar(20)
  tanggalBerakhirLangganan DateTime?          @map("tanggal_berakhir_langganan") @db.Timestamp(6)
  tanggalMulaiLangganan    DateTime?          @map("tanggal_mulai_langganan") @db.Timestamp(6)
  pendaftaranTenant        PendaftaranTenant?
  pengguna                 Pengguna[]
  sekolah                  Sekolah[]
  paket                    Paket?             @relation(fields: [paketId], references: [id])

  @@index([paketId])
  @@map("yayasan")
}

model Paket {
  id                String              @id @default(uuid())
  dibuatOleh        String?             @map("dibuat_oleh")
  diperbaruiOleh    String?             @map("diperbarui_oleh")
  dihapusOleh       String?             @map("dihapus_oleh")
  nama              String              @db.VarChar(100)
  deskripsi         String?
  harga             Decimal             @db.Decimal(15, 2)
  durasi            Int
  status            String?             @db.VarChar(20)
  dibuatPada        DateTime            @default(now()) @map("dibuat_pada") @db.Timestamp(6)
  diperbaruiPada    DateTime            @updatedAt @map("diperbarui_pada") @db.Timestamp(6)
  dihapusPada       DateTime?           @map("dihapus_pada") @db.Timestamp(6)
  tipe              TipePaket           @default(SEKOLAH)
  langgananSekolah  LanggananSekolah[]
  paketModul        PaketModul[]
  pendaftaranTenant PendaftaranTenant[]
  yayasan           Yayasan[]

  @@map("paket")
}

model Modul {
  id             String         @id @default(uuid())
  dibuatOleh     String?        @map("dibuat_oleh")
  diperbaruiOleh String?        @map("diperbarui_oleh")
  dihapusOleh    String?        @map("dihapus_oleh")
  kode           String         @unique @db.VarChar(20)
  nama           String         @db.VarChar(100)
  deskripsi      String?
  ikon           String?        @db.VarChar(50)
  sistem         Boolean?
  status         String?        @default("aktif") @db.VarChar(20)
  dibuatPada     DateTime       @default(now()) @map("dibuat_pada") @db.Timestamp(6)
  diperbaruiPada DateTime       @updatedAt @map("diperbarui_pada") @db.Timestamp(6)
  dihapusPada    DateTime?      @map("dihapus_pada") @db.Timestamp(6)
  paketModul     PaketModul[]
  sekolahModul   SekolahModul[]

  @@map("modul")
}

model PaketModul {
  id             String    @id @default(uuid())
  paketId        String    @map("paket_id")
  modulId        String    @map("modul_id")
  dibuatOleh     String?   @map("dibuat_oleh")
  diperbaruiOleh String?   @map("diperbarui_oleh")
  dihapusOleh    String?   @map("dihapus_oleh")
  status         String?   @db.VarChar(20)
  dibuatPada     DateTime  @default(now()) @map("dibuat_pada") @db.Timestamp(6)
  diperbaruiPada DateTime  @updatedAt @map("diperbarui_pada") @db.Timestamp(6)
  dihapusPada    DateTime? @map("dihapus_pada") @db.Timestamp(6)
  modul          Modul     @relation(fields: [modulId], references: [id])
  paket          Paket     @relation(fields: [paketId], references: [id])

  @@map("paket_modul")
}

model SekolahModul {
  id              String    @id @default(uuid())
  sekolahId       String    @map("sekolah_id")
  modulId         String    @map("modul_id")
  dibuatOleh      String?   @map("dibuat_oleh")
  diperbaruiOleh  String?   @map("diperbarui_oleh")
  dihapusOleh     String?   @map("dihapus_oleh")
  status          String?   @db.VarChar(20)
  diaktifkanPada  DateTime? @map("diaktifkan_pada") @db.Timestamp(6)
  kedaluwarsaPada DateTime? @map("kedaluwarsa_pada") @db.Timestamp(6)
  dibuatPada      DateTime  @default(now()) @map("dibuat_pada") @db.Timestamp(6)
  diperbaruiPada  DateTime  @updatedAt @map("diperbarui_pada") @db.Timestamp(6)
  dihapusPada     DateTime? @map("dihapus_pada") @db.Timestamp(6)
  modul           Modul     @relation(fields: [modulId], references: [id])
  sekolah         Sekolah   @relation(fields: [sekolahId], references: [id])

  @@map("sekolah_modul")
}

model LanggananSekolah {
  id                    String              @id @default(uuid())
  sekolahId             String              @map("sekolah_id")
  paketId               String              @map("paket_id")
  dibuatOleh            String?             @map("dibuat_oleh")
  diperbaruiOleh        String?             @map("diperbarui_oleh")
  dihapusOleh           String?             @map("dihapus_oleh")
  statusPembayaran      String?             @map("status_pembayaran") @db.VarChar(20)
  statusLangganan       String?             @map("status_langganan") @db.VarChar(20)
  tanggalMulai          DateTime?           @map("tanggal_mulai") @db.Timestamp(6)
  tanggalBerakhir       DateTime?           @map("tanggal_berakhir") @db.Timestamp(6)
  hargaSaatBerlangganan Decimal?            @map("harga_saat_berlangganan") @db.Decimal(15, 2)
  siklusPenagihan       String?             @map("siklus_penagihan") @db.VarChar(20)
  fiturAktif            Json?               @map("fitur_aktif")
  dibuatPada            DateTime            @default(now()) @map("dibuat_pada") @db.Timestamp(6)
  diperbaruiPada        DateTime            @updatedAt @map("diperbarui_pada") @db.Timestamp(6)
  midtransInvoiceId     String?             @map("midtrans_invoice_id") @db.VarChar(100)
  midtransPaymentLink   String?             @map("midtrans_payment_link") @db.VarChar(255)
  paket                 Paket               @relation(fields: [paketId], references: [id])
  sekolah               Sekolah             @relation("SekolahLangganan", fields: [sekolahId], references: [id])
  riwayatPembayaran     RiwayatPembayaran[]

  @@map("langganan_sekolah")
}

model RiwayatPembayaran {
  id                 String           @id @default(uuid())
  langgananSekolahId String           @map("langganan_sekolah_id")
  sekolahId          String           @map("sekolah_id")
  dibuatOleh         String?          @map("dibuat_oleh")
  diperbaruiOleh     String?          @map("diperbarui_oleh")
  dihapusOleh        String?          @map("dihapus_oleh")
  jumlah             Decimal?         @db.Decimal(15, 2)
  metode             String?          @db.VarChar(50)
  status             String?          @db.VarChar(20)
  webhookRawPayload  Json?            @map("webhook_raw_payload")
  dibuatPada         DateTime         @default(now()) @map("dibuat_pada") @db.Timestamp(6)
  dihapusPada        DateTime?        @map("dihapus_pada") @db.Timestamp(6)
  midtransInvoiceId  String?          @map("midtrans_invoice_id") @db.VarChar(100)
  midtransPaymentId  String?          @map("midtrans_payment_id") @db.VarChar(100)
  sumberTagihan      String?          @map("sumber_tagihan") @db.VarChar(50)
  langgananSekolah   LanggananSekolah @relation(fields: [langgananSekolahId], references: [id])
  sekolah            Sekolah          @relation(fields: [sekolahId], references: [id])

  @@map("riwayat_pembayaran")
}

model Notifikasi {
  id           String    @id @default(uuid())
  penggunaId   String    @map("pengguna_id")
  pengirimId   String?   @map("pengirim_id")
  judul        String    @db.VarChar(100)
  isi          String
  tipe         String?   @db.VarChar(20)
  kategori     String?   @db.VarChar(30)
  targetUrl    String?   @map("target_url") @db.VarChar(255)
  dibaca       Boolean   @default(false)
  dibacaPada   DateTime? @map("dibaca_pada") @db.Timestamp(6)
  dikirimEmail Boolean   @default(false) @map("dikirim_email")
  dibuatPada   DateTime  @default(now()) @map("dibuat_pada") @db.Timestamp(6)
  pengguna     Pengguna  @relation("PenerimaNotifikasi", fields: [penggunaId], references: [id])
  pengirim     Pengguna? @relation("PengirimNotifikasi", fields: [pengirimId], references: [id])

  @@map("notifikasi")
}

model PendaftaranTenant {
  id                 String    @id @default(uuid())
  namaSekolah        String?   @map("nama_sekolah") @db.VarChar(100)
  jenjangSekolah     String?   @map("jenjang_sekolah") @db.VarChar(20)
  subdomain          String?   @db.VarChar(50)
  alamatSekolah      String?   @map("alamat_sekolah")
  teleponSekolah     String?   @map("telepon_sekolah") @db.VarChar(20)
  emailSekolah       String?   @map("email_sekolah") @db.VarChar(100)
  jenisPendaftaran   String    @default("sekolah") @map("jenis_pendaftaran") @db.VarChar(20)
  alamatYayasan      String?   @map("alamat_yayasan")
  dibuatPada         DateTime  @default(now()) @map("dibuat_pada") @db.Timestamp(6)
  dikonversiPada     DateTime? @map("dikonversi_pada") @db.Timestamp(6)
  diperbaruiPada     DateTime  @updatedAt @map("diperbarui_pada") @db.Timestamp(6)
