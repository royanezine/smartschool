generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. SHARED TABLES (Public Schema)
// ==========================================
model Pengguna {
  id             String  @id @default(uuid())
  sekolahId      String? @map("sekolah_id")
  yayasanId      String? @map("yayasan_id")
  peranId        String? @map("peran_id")
  dibuatOleh     String? @map("dibuat_oleh")
  diperbaruiOleh String? @map("diperbarui_oleh")
  dihapusOleh    String? @map("dihapus_oleh")

  namaPengguna String  @unique @map("nama_pengguna") @db.VarChar(50)
  email        String  @unique @db.VarChar(100)
  kataSandi    String  @map("kata_sandi") @db.VarChar(255)
  namaLengkap  String  @map("nama_lengkap") @db.VarChar(100)
  avatar       String? @db.VarChar(255)

  nipd     String? @db.VarChar(20)
  nip      String? @db.VarChar(20)
  nuptk    String? @db.VarChar(20)
  nisn     String? @unique @db.VarChar(20)
  nis      String? @db.VarChar(20)
  jabatan  String? @db.VarChar(100)
  golongan String? @db.VarChar(50)

  nik           String?   @unique @db.VarChar(20)
  alamatKtp     String?   @map("alamat_ktp") @db.Text
  jenisKelamin  String?   @map("jenis_kelamin") @db.VarChar(10)
  tempatLahir   String?   @map("tempat_lahir") @db.VarChar(50)
  tanggalLahir  DateTime? @map("tanggal_lahir") @db.Date
  provinsi      String?   @db.VarChar(50)
  kotaKabupaten String?   @map("kota_kabupaten") @db.VarChar(50)
  kecamatan     String?   @db.VarChar(50)
  kelurahan     String?   @db.VarChar(50)
  kodePos       String?   @map("kode_pos") @db.VarChar(10)
  alamat        String?   @db.Text

  namaAyah      String? @map("nama_ayah") @db.VarChar(100)
  nikAyah       String? @map("nik_ayah") @db.VarChar(20)
  pekerjaanAyah String? @map("pekerjaan_ayah") @db.VarChar(50)
  noHpAyah      String? @map("no_hp_ayah") @db.VarChar(20)

  namaIbu      String? @map("nama_ibu") @db.VarChar(100)
  nikIbu       String? @map("nik_ibu") @db.VarChar(20)
  pekerjaanIbu String? @map("pekerjaan_ibu") @db.VarChar(50)
  noHpIbu      String? @map("no_hp_ibu") @db.VarChar(20)

  alamatDomisili       String?  @map("alamat_domisili") @db.Text
  alamatSesuaiDomisili Boolean? @default(true) @map("alamat_sesuai_domisili")
  noTelepon            String?  @map("no_telepon_rumah") @db.VarChar(20)
  namaWaliPesertaDidik String?  @map("nama_wali_peserta_didik") @db.VarChar(20)

  status        String?   @db.VarChar(20)
  terakhirLogin DateTime? @map("terakhir_login") @db.Timestamp()
  kodeOtp       String?   @map("kode_otp") @db.VarChar(10)
  otpTimeout    DateTime? @map("otp_timeout") @db.Timestamp()

  dibuatPada     DateTime  @default(now()) @map("dibuat_pada") @db.Timestamp()
  diperbaruiPada DateTime  @updatedAt @map("diperbarui_pada") @db.Timestamp()
  dihapusPada    DateTime? @map("dihapus_pada") @db.Timestamp()

  sekolah Sekolah? @relation(fields: [sekolahId], references: [id])
  yayasan Yayasan? @relation(fields: [yayasanId], references: [id])
  peran   Peran?   @relation(fields: [peranId], references: [id])

  kelasWali             Kelas[]            @relation("WaliKelas")
  kelasMapelDiajar      KelasMapel[]       @relation("GuruPengajar")
  nilaiSiswa            Nilai[]
  absensiSiswa          Absensi[]
  pengumpulanTugasSiswa PengumpulanTugas[]
  pendaftaranPpdb       PendaftaranPpdb[]
  kelasSiswa            AnggotaKelas[]     @relation("SiswaKelas")
  notifikasiDiterima    Notifikasi[]       @relation("PenerimaNotifikasi")
  notifikasiDikirim     Notifikasi[]       @relation("PengirimNotifikasi")
  auditLogs             AuditLog[]
  percobaanAsesmen      PercobaanAsesmen[]
  biometrikWajah        BiometrikWajah?

  @@map("pengguna")
}

model Peran {
  id             String    @id @default(uuid())
  sekolahId      String?   @map("sekolah_id")
  dibuatOleh     String?   @map("dibuat_oleh")
  diperbaruiOleh String?   @map("diperbarui_oleh")
  dihapusOleh    String?   @map("dihapus_oleh")
  nama           String    @db.VarChar(50)
  namaTampilan   String    @map("nama_tampilan") @db.VarChar(100)
  deskripsi      String?   @db.Text
  status         String?   @db.VarChar(20)
  dibuatPada     DateTime  @default(now()) @map("dibuat_pada") @db.Timestamp()
  diperbaruiPada DateTime  @updatedAt @map("diperbarui_pada") @db.Timestamp()
  dihapusPada    DateTime? @map("dihapus_pada") @db.Timestamp()

  sekolah   Sekolah?    @relation(fields: [sekolahId], references: [id], onDelete: Cascade)
  pengguna  Pengguna[]
  peranIzin PeranIzin[]

  @@unique([nama, sekolahId])
  @@map("peran")
}

model Izin {
  id             String    @id @default(uuid())
  dibuatOleh     String?   @map("dibuat_oleh")
  diperbaruiOleh String?   @map("diperbarui_oleh")
  dihapusOleh    String?   @map("dihapus_oleh")
  nama           String    @unique @db.VarChar(100)
  modul          String    @db.VarChar(50)
  aksi           String    @db.VarChar(50)
  status         String?   @db.VarChar(20)
  dibuatPada     DateTime  @default(now()) @map("dibuat_pada") @db.Timestamp()
  diperbaruiPada DateTime  @updatedAt @map("diperbarui_pada") @db.Timestamp()
  dihapusPada    DateTime? @map("dihapus_pada") @db.Timestamp()

  peranIzin PeranIzin[]

  @@map("izin")
}

model PeranIzin {
  id             String    @id @default(uuid())
  dibuatOleh     String?   @map("dibuat_oleh")
  diperbaruiOleh String?   @map("diperbarui_oleh")
  dihapusOleh    String?   @map("dihapus_oleh")
  peranId        String    @map("peran_id")
  izinId         String    @map("izin_id")
  dibuatPada     DateTime  @default(now()) @map("dibuat_pada") @db.Timestamp()
  diperbaruiPada DateTime  @updatedAt @map("diperbarui_pada") @db.Timestamp()
  dihapusPada    DateTime? @map("dihapus_pada") @db.Timestamp()

  peran Peran @relation(fields: [peranId], references: [id])
  izin  Izin  @relation(fields: [izinId], references: [id])

  @@map("peran_izin")
}

model Sekolah {
  id               String  @id @default(uuid())
  yayasanId        String? @map("yayasan_id")
  langgananAktifId String? @unique @map("langganan_aktif_id")
  dibuatOleh       String? @map("dibuat_oleh")
  diperbaruiOleh   String? @map("diperbarui_oleh")
  dihapusOleh      String? @map("dihapus_oleh")
  npsn             String? @unique @map("npsn") @db.VarChar(50)
  nama             String  @db.VarChar(100)
  subdomain        String  @unique @db.VarChar(50)
  alamat           String? @db.Text
  telepon          String? @db.VarChar(20)
  email            String? @db.VarChar(100)
  kode             String  @unique @db.VarChar(20)

  logoBesarUrl String? @map("logo_besar_url") @db.VarChar(255)
  logoKecilUrl String? @map("logo_kecil_url") @db.VarChar(255)
  faviconUrl   String? @map("favicon_url") @db.VarChar(255)
  status       String? @db.VarChar(20)
  jenjang      String? @db.VarChar(20)
  konfigurasi  Json?

  lintang            Decimal? @db.Decimal(10, 8)
  bujur              Decimal? @db.Decimal(11, 8)
  radiusAbsensi      Int?     @map("radius_absensi")
  metodeAbsensiAktif String[] @map("metode_absensi_aktif")

  dibuatPada     DateTime  @default(now()) @map("dibuat_pada") @db.Timestamp()
  diperbaruiPada DateTime  @updatedAt @map("diperbarui_pada") @db.Timestamp()
  dihapusPada    DateTime? @map("dihapus_pada") @db.Timestamp()

  yayasan           Yayasan?            @relation(fields: [yayasanId], references: [id])
  pengguna          Pengguna[]
  tahunAjaran       TahunAjaran[]
  kelas             Kelas[]
  mataPelajaran     MataPelajaran[]
  sekolahModul      SekolahModul[]
  aset              Aset[]
  halamanCms        HalamanCms[]
  artikelCms        ArtikelCms[]
  jalurPpdb         JalurPpdb[]
  pendaftaranPpdb   PendaftaranPpdb[]
  langgananSekolah  LanggananSekolah[]  @relation("SekolahLangganan")
  riwayatPembayaran RiwayatPembayaran[]
  gedung            Gedung[]
  auditLogs         AuditLog[]
  pengaturanSistem  PengaturanSistem[]
  menuKonfigurasi   MenuKonfigurasi[]
  peran             Peran[]

  @@map("sekolah")
}

model Yayasan {
  id             String    @id @default(uuid())
  dibuatOleh     String?   @map("dibuat_oleh")
  diperbaruiOleh String?   @map("diperbarui_oleh")
  dihapusOleh    String?   @map("dihapus_oleh")
  npyp           String?   @unique @db.VarChar(50)
  nama           String    @db.VarChar(100)
  alamat         String?   @db.Text
  telepon        String?   @db.VarChar(20)
  email          String?   @db.VarChar(100)
  status         String?   @default("aktif") @db.VarChar(20)
  dibuatPada     DateTime  @default(now()) @map("dibuat_pada") @db.Timestamp()
  diperbaruiPada DateTime  @updatedAt @map("diperbarui_pada") @db.Timestamp()
  dihapusPada    DateTime? @map("dihapus_pada") @db.Timestamp()

  sekolah           Sekolah[]
  pengguna          Pengguna[]
  pendaftaranTenant PendaftaranTenant[]

  @@map("yayasan")
}

model Paket {
  id             String    @id @default(uuid())
  dibuatOleh     String?   @map("dibuat_oleh")
  diperbaruiOleh String?   @map("diperbarui_oleh")
  dihapusOleh    String?   @map("dihapus_oleh")
  nama           String    @db.VarChar(100)
  deskripsi      String?   @db.Text
  harga          Decimal   @db.Decimal(15, 2)
  durasi         Int
  status         String?   @db.VarChar(20)
  dibuatPada     DateTime  @default(now()) @map("dibuat_pada") @db.Timestamp()
  diperbaruiPada DateTime  @updatedAt @map("diperbarui_pada") @db.Timestamp()
  dihapusPada    DateTime? @map("dihapus_pada") @db.Timestamp()

  paketModul        PaketModul[]
  langgananSekolah  LanggananSekolah[]
  pendaftaranTenant PendaftaranTenant[]

  @@map("paket")
}

model Modul {
  id             String    @id @default(uuid())
  dibuatOleh     String?   @map("dibuat_oleh")
  diperbaruiOleh String?   @map("diperbarui_oleh")
  dihapusOleh    String?   @map("dihapus_oleh")
  kode           String    @unique @db.VarChar(20)
  nama           String    @db.VarChar(100)
  deskripsi      String?   @db.Text
  ikon           String?   @db.VarChar(50)
  sistem         Boolean?
  status         String?   @db.VarChar(20)
  dibuatPada     DateTime  @default(now()) @map("dibuat_pada") @db.Timestamp()
  diperbaruiPada DateTime  @updatedAt @map("diperbarui_pada") @db.Timestamp()
  dihapusPada    DateTime? @map("dihapus_pada") @db.Timestamp()

  paketModul   PaketModul[]
  sekolahModul SekolahModul[]

  @@map("modul")
}

model PaketModul {
  id             String    @id @default(uuid())
  paketId        String    @map("paket_id")
  modulId        String    @map("modul_id")
  dibuatOleh     String?   @map("dibuat_oleh")
  diperbaruiOleh String?   @map("diperbarui_oleh")
  dihapusOleh    String?   @map("dihapus_oleh")
  status         String?   @db.VarChar(20)
  dibuatPada     DateTime  @default(now()) @map("dibuat_pada") @db.Timestamp()
  diperbaruiPada DateTime  @updatedAt @map("diperbarui_pada") @db.Timestamp()
  dihapusPada    DateTime? @map("dihapus_pada") @db.Timestamp()

  paket Paket @relation(fields: [paketId], references: [id])
  modul Modul @relation(fields: [modulId], references: [id])

  @@map("paket_modul")
}

model SekolahModul {
  id              String    @id @default(uuid())
  sekolahId       String    @map("sekolah_id")
  modulId         String    @map("modul_id")
  dibuatOleh      String?   @map("dibuat_oleh")
  diperbaruiOleh  String?   @map("diperbarui_oleh")
  dihapusOleh     String?   @map("dihapus_oleh")
  status          String?   @db.VarChar(20)
  diaktifkanPada  DateTime? @map("diaktifkan_pada") @db.Timestamp()
  kedaluwarsaPada DateTime? @map("kedaluwarsa_pada") @db.Timestamp()
  dibuatPada      DateTime  @default(now()) @map("dibuat_pada") @db.Timestamp()
  diperbaruiPada  DateTime  @updatedAt @map("diperbarui_pada") @db.Timestamp()
  dihapusPada     DateTime? @map("dihapus_pada") @db.Timestamp()

  sekolah Sekolah @relation(fields: [sekolahId], references: [id])
  modul   Modul   @relation(fields: [modulId], references: [id])

  @@map("sekolah_modul")
}

model LanggananSekolah {
  id                    String    @id @default(uuid())
  sekolahId             String    @map("sekolah_id")
  paketId               String    @map("paket_id")
  dibuatOleh            String?   @map("dibuat_oleh")
  diperbaruiOleh        String?   @map("diperbarui_oleh")
  dihapusOleh           String?   @map("dihapus_oleh")
  statusPembayaran      String?   @map("status_pembayaran") @db.VarChar(20)
  statusLangganan       String?   @map("status_langganan") @db.VarChar(20)
  tanggalMulai          DateTime? @map("tanggal_mulai") @db.Timestamp()
  tanggalBerakhir       DateTime? @map("tanggal_berakhir") @db.Timestamp()
  hargaSaatBerlangganan Decimal?  @map("harga_saat_berlangganan") @db.Decimal(15, 2)
  siklusPenagihan       String?   @map("siklus_penagihan") @db.VarChar(20)
  fiturAktif            Json?     @map("fitur_aktif")
  midtransInvoiceId     String?   @map("midtrans_invoice_id") @db.VarChar(100)
  midtransPaymentLink   String?   @map("midtrans_payment_link") @db.VarChar(255)
  dibuatPada            DateTime  @default(now()) @map("dibuat_pada") @db.Timestamp()
  diperbaruiPada        DateTime  @updatedAt @map("diperbarui_pada") @db.Timestamp()

  sekolah           Sekolah             @relation("SekolahLangganan", fields: [sekolahId], references: [id])
  paket             Paket               @relation(fields: [paketId], references: [id])
  riwayatPembayaran RiwayatPembayaran[]

  @@map("langganan_sekolah")
}

model RiwayatPembayaran {
  id                 String    @id @default(uuid())
  langgananSekolahId String    @map("langganan_sekolah_id")
  sekolahId          String    @map("sekolah_id")
  dibuatOleh         String?   @map("dibuat_oleh")
  diperbaruiOleh     String?   @map("diperbarui_oleh")
  dihapusOleh        String?   @map("dihapus_oleh")
  sumberTagihan      String?   @map("sumber_tagihan") @db.VarChar(50)
  jumlah             Decimal?  @db.Decimal(15, 2)
  metode             String?   @db.VarChar(50)
  status             String?   @db.VarChar(20)
  midtransPaymentId  String?   @map("midtrans_payment_id") @db.VarChar(100)
  midtransInvoiceId  String?   @map("midtrans_invoice_id") @db.VarChar(100)
  webhookRawPayload  Json?     @map("webhook_raw_payload")
  dibuatPada         DateTime  @default(now()) @map("dibuat_pada") @db.Timestamp()
  dihapusPada        DateTime? @map("dihapus_pada") @db.Timestamp()

  langgananSekolah LanggananSekolah @relation(fields: [langgananSekolahId], references: [id])
  sekolah          Sekolah?         @relation(fields: [sekolahId], references: [id])

  @@map("riwayat_pembayaran")
}

model Notifikasi {
  id           String    @id @default(uuid())
  penggunaId   String    @map("pengguna_id")
  pengirimId   String?   @map("pengirim_id")
  judul        String    @db.VarChar(100)
  isi          String    @db.Text
  tipe         String?   @db.VarChar(20)
  kategori     String?   @db.VarChar(30)
  targetUrl    String?   @map("target_url") @db.VarChar(255)
  dibaca       Boolean   @default(false)
  dibacaPada   DateTime? @map("dibaca_pada") @db.Timestamp()
  dikirimEmail Boolean   @default(false) @map("dikirim_email")
  dibuatPada   DateTime  @default(now()) @map("dibuat_pada") @db.Timestamp()

  pengguna Pengguna  @relation("PenerimaNotifikasi", fields: [penggunaId], references: [id])
  pengirim Pengguna? @relation("PengirimNotifikasi", fields: [pengirimId], references: [id])

  @@map("notifikasi")
}

model PendaftaranTenant {
  id                 String @id @default(uuid())
  namaPendaftar      String @map("nama_pendaftar") @db.VarChar(100)
  emailPendaftar     String @map("email_pendaftar") @db.VarChar(100)
  kataSandiPendaftar String @map("kata_sandi_pendaftar") @db.VarChar(255)

  namaYayasan    String? @map("nama_yayasan") @db.VarChar(100)
  alamatYayasan  String? @map("alamat_yayasan") @db.Text
  teleponYayasan String? @map("telepon_yayasan") @db.VarChar(20)
  emailYayasan   String? @map("email_yayasan") @db.VarChar(100)
  npypYayasan    String? @map("npyp_yayasan") @db.VarChar(50)

  namaSekolah    String  @map("nama_sekolah") @db.VarChar(100)
  jenjangSekolah String  @map("jenjang_sekolah") @db.VarChar(20)
  subdomain      String  @db.VarChar(50)
  alamatSekolah  String  @map("alamat_sekolah") @db.Text
  teleponSekolah String  @map("telepon_sekolah") @db.VarChar(20)
  emailSekolah   String  @map("email_sekolah") @db.VarChar(100)
  logoSekolah    String? @map("logo_sekolah") @db.VarChar(255)

  paketId         String    @map("paket_id")
  midtransOrderId String?   @map("midtrans_order_id") @db.VarChar(100)
  kodeOtp         String?   @map("kode_otp") @db.VarChar(10)
  otpTimeout      DateTime? @map("otp_timeout") @db.Timestamp()
  status          String    @default("menunggu_verifikasi") @db.VarChar(20)

  yayasanTerbuatId  String? @unique @map("yayasan_terbuat_id")
  sekolahTerbuatId  String? @unique @map("sekolah_terbuat_id")
  penggunaTerbuatId String? @unique @map("pengguna_terbuat_id")

  dikonversiPada DateTime? @map("dikonversi_pada") @db.Timestamp()
  dibuatPada     DateTime  @default(now()) @map("dibuat_pada") @db.Timestamp()
  diperbaruiPada DateTime  @updatedAt @map("diperbarui_pada") @db.Timestamp()

  paket   Paket    @relation(fields: [paketId], references: [id])
  yayasan Yayasan? @relation(fields: [yayasanTerbuatId], references: [id])

  @@map("pendaftaran_tenant")
}

model AuditLog {
  id         String   @id @default(uuid())
  penggunaId String   @map("pengguna_id")
  sekolahId  String?  @map("sekolah_id") // Biarkan opsional untuk log global
  aksi       String   @db.VarChar(50)
  modul      String   @db.VarChar(50)
  entitasId  String?  @map("entitas_id") @db.VarChar(50)
  dataLama   Json?    @map("data_lama")
  dataBaru   Json?    @map("data_baru")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  waktu      DateTime @default(now()) @db.Timestamp()

  pengguna Pengguna @relation(fields: [penggunaId], references: [id])
  sekolah  Sekolah? @relation(fields: [sekolahId], references: [id])

  @@map("audit_log")
}

model PengaturanSistem {
  id             String  @id @default(uuid())
  sekolahId      String? @map("sekolah_id")
  dibuatOleh     String? @map("dibuat_oleh")
  diperbaruiOleh String? @map("diperbarui_oleh")
  dihapusOleh    String? @map("dihapus_oleh")

  kunci      String  @db.VarChar(100)
  nilai      String  @db.Text
  tipeData   String  @map("tipe_data") @db.VarChar(20)
  kelompok   String  @db.VarChar(20)
  keterangan String? @db.Text

  dibuatPada     DateTime  @default(now()) @map("dibuat_pada") @db.Timestamp()
  diperbaruiPada DateTime  @updatedAt @map("diperbarui_pada") @db.Timestamp()
  dihapusPada    DateTime? @map("dihapus_pada") @db.Timestamp()

  sekolah Sekolah? @relation(fields: [sekolahId], references: [id])

  @@map("pengaturan_sistem")
}

model MenuKonfigurasi {
  id             String  @id @default(uuid())
  sekolahId      String  @map("sekolah_id")
  dibuatOleh     String? @map("dibuat_oleh")
  diperbaruiOleh String? @map("diperbarui_oleh")
  dihapusOleh    String? @map("dihapus_oleh")

  halaman   String  @db.VarChar(50)
  section   String  @db.VarChar(50)
  judul     String  @db.VarChar(100)
  subJudul  String? @map("sub_judul") @db.VarChar(255)
  konten    String? @db.Text
  gambarUrl String? @map("gambar_url") @db.VarChar(255)
  ctaText   String? @map("cta_text") @db.VarChar(50)
  ctaLink   String? @map("cta_link") @db.VarChar(255)
  urutan    Int
  status    String? @db.VarChar(20)

  dibuatPada     DateTime @default(now()) @map("dibuat_pada") @db.Timestamp()
  diperbaruiPada DateTime @updatedAt @map("diperbarui_pada") @db.Timestamp()

  sekolah Sekolah @relation(fields: [sekolahId], references: [id])

  @@map("menu_konfigurasi")
}

// ==========================================
// 2. TENANT TABLES (Per Sekolah)
// ==========================================
model TahunAjaran {
  id             String  @id @default(uuid())
  sekolahId      String  @map("sekolah_id")
  dibuatOleh     String? @map("dibuat_oleh")
  diperbaruiOleh String? @map("diperbarui_oleh")
  dihapusOleh    String? @map("dihapus_oleh")

  tahunAjaran    String    @map("tahun_ajaran") @db.VarChar(20)
  semester       String    @db.VarChar(10)
  tanggalMulai   DateTime? @map("tanggal_mulai") @db.Date
  tanggalSelesai DateTime? @map("tanggal_selesai") @db.Date
  status         String    @default("tidak_aktif") @db.VarChar(20)

  dibuatPada     DateTime  @default(now()) @map("dibuat_pada") @db.Timestamp()
  diperbaruiPada DateTime  @updatedAt @map("diperbarui_pada") @db.Timestamp()
  dihapusPada    DateTime? @map("dihapus_pada") @db.Timestamp()

  sekolah Sekolah @relation(fields: [sekolahId], references: [id])
  kelas   Kelas[]

  @@map("tahun_ajaran")
}

model Kelas {
  id             String  @id @default(uuid())
  sekolahId      String  @map("sekolah_id")
  tahunAjaranId  String  @map("tahun_ajaran_id")
  waliKelasId    String? @map("wali_kelas_id")
  dibuatOleh     String? @map("dibuat_oleh")
  diperbaruiOleh String? @map("diperbarui_oleh")
  dihapusOleh    String? @map("dihapus_oleh")

  gedungId     String? @map("gedung_id")
  lantaiId     String? @map("lantai_id")
  fotoKelas    String? @map("foto_kelas") @db.VarChar(255)
  nama         String  @db.VarChar(50)
  tingkat      String  @db.VarChar(20)
  nomorRuangan String? @map("nomor_ruangan") @db.VarChar(20)
  kapasitas    Int?    @default(30)
  status       String? @db.VarChar(20)

  dibuatPada     DateTime  @default(now()) @map("dibuat_pada") @db.Timestamp()
  diperbaruiPada DateTime  @updatedAt @map("diperbarui_pada") @db.Timestamp()
  dihapusPada    DateTime? @map("dihapus_pada") @db.Timestamp()

  sekolah     Sekolah     @relation(fields: [sekolahId], references: [id])
  waliKelas   Pengguna?   @relation("WaliKelas", fields: [waliKelasId], references: [id])
  tahunAjaran TahunAjaran @relation(fields: [tahunAjaranId], references: [id])
  gedung      Gedung?     @relation(fields: [gedungId], references: [id])
  lantai      Lantai?     @relation(fields: [lantaiId], references: [id])

  anggota    AnggotaKelas[]
  kelasMapel KelasMapel[]
  absensi    Absensi[]

  @@map("kelas")
}

model MataPelajaran {
  id             String  @id @default(uuid())
  sekolahId      String  @map("sekolah_id")
  dibuatOleh     String? @map("dibuat_oleh")
  diperbaruiOleh String? @map("diperbarui_oleh")
  dihapusOleh    String? @map("dihapus_oleh")

  nama   String  @db.VarChar(100)
  kode   String  @db.VarChar(20)
  status String? @db.VarChar(20)

  dibuatPada     DateTime  @default(now()) @map("dibuat_pada") @db.Timestamp()
  diperbaruiPada DateTime  @updatedAt @map("diperbarui_pada") @db.Timestamp()
  dihapusPada    DateTime? @map("dihapus_pada") @db.Timestamp()

  sekolah    Sekolah      @relation(fields: [sekolahId], references: [id])
  kelasMapel KelasMapel[]

  @@map("mata_pelajaran")
}

model KelasMapel {
  id              String    @id @default(uuid())
  kelasId         String    @map("kelas_id")
  mataPelajaranId String    @map("mata_pelajaran_id")
  guruPengajarId  String    @map("guru_pengajar_id")
  dibuatOleh      String?   @map("dibuat_oleh")
  diperbaruiOleh  String?   @map("diperbarui_oleh")
  dihapusOleh     String?   @map("dihapus_oleh")
  status          String?   @db.VarChar(20)
  dibuatPada      DateTime  @default(now()) @map("dibuat_pada") @db.Timestamp()
  diperbaruiPada  DateTime  @updatedAt @map("diperbarui_pada") @db.Timestamp()
  dihapusPada     DateTime? @map("dihapus_pada") @db.Timestamp()

  kelas         Kelas         @relation(fields: [kelasId], references: [id])
  mataPelajaran MataPelajaran @relation(fields: [mataPelajaranId], references: [id])
  guruPengajar  Pengguna      @relation("GuruPengajar", fields: [guruPengajarId], references: [id])

  komponenNilai      KomponenNilai[]
  nilai              Nilai[]
  asesmen            Asesmen[]
  tugas              Tugas[]
  materiPembelajaran MateriPembelajaran[]
  jadwalMengajar     JadwalMengajar[]

  @@map("kelas_mapel")
}

model AnggotaKelas {
  id             String  @id @default(uuid())
  kelasId        String  @map("kelas_id")
  penggunaId     String  @map("pengguna_id")
  tahunAjaranId  String  @map("tahun_ajaran_id")
  dibuatOleh     String? @map("dibuat_oleh")
  diperbaruiOleh String? @map("diperbarui_oleh")
  dihapusOleh    String? @map("dihapus_oleh")
  status         String? @db.VarChar(20)

  dibuatPada     DateTime  @default(now()) @map("dibuat_pada") @db.Timestamp()
  diperbaruiPada DateTime  @updatedAt @map("diperbarui_pada") @db.Timestamp()
  dihapusPada    DateTime? @map("dihapus_pada") @db.Timestamp()

  kelas Kelas    @relation(fields: [kelasId], references: [id])
  siswa Pengguna @relation("SiswaKelas", fields: [penggunaId], references: [id])

  @@map("anggota_kelas")
}

model KomponenNilai {
  id             String   @id @default(uuid())
  kelasMapelId   String   @map("kelas_mapel_id")
  dibuatOleh     String?  @map("dibuat_oleh")
  diperbaruiOleh String?  @map("diperbarui_oleh")
  dihapusOleh    String?  @map("dihapus_oleh")
  nama           String   @db.VarChar(50)
  jenis          String   @db.VarChar(20)
  bobot          Decimal  @db.Decimal(5, 2)
  nilaiMaksimum  Decimal  @map("nilai_maksimum") @db.Decimal(5, 2)
  kelompok       String   @db.VarChar(30)
  status         String?  @db.VarChar(20)
  dibuatPada     DateTime @default(now()) @map("dibuat_pada") @db.Timestamp()
  diperbaruiPada DateTime @updatedAt @map("diperbarui_pada") @db.Timestamp()

  kelasMapel KelasMapel @relation(fields: [kelasMapelId], references: [id])
  nilai      Nilai[]

  @@map("komponen_nilai")
}

model Nilai {
  id              String   @id @default(uuid())
  penggunaId      String   @map("pengguna_id")
  kelasMapelId    String   @map("kelas_mapel_id")
  komponenNilaiId String   @map("komponen_nilai_id")
  dibuatOleh      String?  @map("dibuat_oleh")
  diperbaruiOleh  String?  @map("diperbarui_oleh")
  dihapusOleh     String?  @map("dihapus_oleh")
  nilai           Decimal  @db.Decimal(5, 2)
  sumber          String?  @db.VarChar(20)
  sumberId        String?  @map("sumber_id")
  catatan         String?  @db.Text
  dibuatPada      DateTime @default(now()) @map("dibuat_pada") @db.Timestamp()
  diperbaruiPada  DateTime @updatedAt @map("diperbarui_pada") @db.Timestamp()

  pengguna      Pengguna      @relation(fields: [penggunaId], references: [id])
  kelasMapel    KelasMapel    @relation(fields: [kelasMapelId], references: [id])
  komponenNilai KomponenNilai @relation(fields: [komponenNilaiId], references: [id])

  @@map("nilai")
}

model Absensi {
  id               String   @id @default(uuid())
  penggunaId       String   @map("pengguna_id")
  biometrikWajahId String?  @map("biometrik_wajah_id")
  kelasId          String   @map("kelas_id")
  dibuatOleh       String?  @map("dibuat_oleh")
  diperbaruiOleh   String?  @map("diperbarui_oleh")
  dihapusOleh      String?  @map("dihapus_oleh")
  tanggal          DateTime @db.Date
  status           String   @db.VarChar(10)
  keterangan       String?  @db.Text
  metode           String?  @db.VarChar(20)
  lintang          Decimal? @db.Decimal(10, 8)
  bujur            Decimal? @db.Decimal(11, 8)
  urlFoto          String?  @map("url_foto") @db.VarChar(255)
  skorKemiripan    Decimal? @map("skor_kemiripan") @db.Decimal(5, 4)
  dibuatPada       DateTime @default(now()) @map("dibuat_pada") @db.Timestamp()
  diperbaruiPada   DateTime @updatedAt @map("diperbarui_pada") @db.Timestamp()

  pengguna       Pengguna        @relation(fields: [penggunaId], references: [id])
  kelas          Kelas           @relation(fields: [kelasId], references: [id])
  biometrikWajah BiometrikWajah? @relation(fields: [biometrikWajahId], references: [id])

  @@map("absensi")
}

model BiometrikWajah {
  id               String    @id @default(uuid())
  penggunaId       String    @unique @map("pengguna_id")
  dibuatOleh       String?   @map("dibuat_oleh")
  diperbaruiOleh   String?   @map("diperbarui_oleh")
  dihapusOleh      String?   @map("dihapus_oleh")
  embeddingVector  Json?     @map("embedding_vector") // Fallback to JSON if pgvector not used
  urlFotoReferensi String?   @map("url_foto_referensi") @db.VarChar(255)
  perangkat        String?   @db.VarChar(50)
  status           String?   @db.VarChar(20)
  dibuatPada       DateTime  @default(now()) @map("dibuat_pada") @db.Timestamp()
  diperbaruiPada   DateTime  @updatedAt @map("diperbarui_pada") @db.Timestamp()
  dihapusPada      DateTime? @map("dihapus_pada") @db.Timestamp()

  pengguna Pengguna  @relation(fields: [penggunaId], references: [id])
  absensi  Absensi[]

  @@map("biometrik_wajah")
}

// ==========================================
// 3. LMS & ASESMEN TABLES
// ==========================================
model Asesmen {
  id             String  @id @default(uuid())
  kelasMapelId   String  @map("kelas_mapel_id")
  dibuatOleh     String? @map("dibuat_oleh")
  diperbaruiOleh String? @map("diperbarui_oleh")
  dihapusOleh    String? @map("dihapus_oleh")

  judul             String    @db.VarChar(100)
  deskripsi         String?   @db.Text
  tipe              String    @db.VarChar(20)
  token             String?   @db.VarChar(10)
  durasi            Int
  waktuMulai        DateTime? @map("waktu_mulai") @db.Timestamp()
  waktuSelesai      DateTime? @map("waktu_selesai") @db.Timestamp()
  nilaiKelulusan    Decimal?  @map("nilai_kelulusan") @db.Decimal(5, 2)
  dipublikasikan    Boolean   @default(false)
  modeAsesmen       String?   @map("mode_asesmen") @db.VarChar(20)
  penilaianOtomatis Boolean   @default(true) @map("penilaian_otomatis")

  dibuatPada     DateTime  @default(now()) @map("dibuat_pada") @db.Timestamp()
  diperbaruiPada DateTime  @updatedAt @map("diperbarui_pada") @db.Timestamp()
  dihapusPada    DateTime? @map("dihapus_pada") @db.Timestamp()

  kelasMapel       KelasMapel         @relation(fields: [kelasMapelId], references: [id])
  soalAsesmen      SoalAsesmen[]
  percobaanAsesmen PercobaanAsesmen[]

  @@map("asesmen")
}

model SoalAsesmen {
  id             String  @id @default(uuid())
  asesmenId      String  @map("asesmen_id")
  dibuatOleh     String? @map("dibuat_oleh")
  diperbaruiOleh String? @map("diperbarui_oleh")
  dihapusOleh    String? @map("dihapus_oleh")

  teksSoal     String  @map("teks_soal") @db.Text
  jenisSoal    String  @map("jenis_soal") @db.VarChar(20)
  pilihan      Json?
  kunciJawaban String? @map("kunci_jawaban") @db.Text
  poin         Decimal @db.Decimal(5, 2)
  nomorUrut    Int     @map("nomor_urut")

  dibuatPada     DateTime  @default(now()) @map("dibuat_pada") @db.Timestamp()
  diperbaruiPada DateTime  @updatedAt @map("diperbarui_pada") @db.Timestamp()
  dihapusPada    DateTime? @map("dihapus_pada") @db.Timestamp()

  asesmen        Asesmen          @relation(fields: [asesmenId], references: [id])
  jawabanAsesmen JawabanAsesmen[]

  @@map("soal_asesmen")
}

model PercobaanAsesmen {
  id             String  @id @default(uuid())
  asesmenId      String  @map("asesmen_id")
  siswaId        String  @map("siswa_id")
  dibuatOleh     String? @map("dibuat_oleh")
  diperbaruiOleh String? @map("diperbarui_oleh")
  dihapusOleh    String? @map("dihapus_oleh")

  dimulaiPada DateTime  @map("dimulai_pada") @db.Timestamp()
  selesaiPada DateTime? @map("selesai_pada") @db.Timestamp()
  tokenSesi   String?   @map("token_sesi") @db.VarChar(255)
  nilai       Decimal?  @db.Decimal(5, 2)
  status      String?   @db.VarChar(20)

  dibuatPada     DateTime  @default(now()) @map("dibuat_pada") @db.Timestamp()
  diperbaruiPada DateTime  @updatedAt @map("diperbarui_pada") @db.Timestamp()
  dihapusPada    DateTime? @map("dihapus_pada") @db.Timestamp()

  asesmen        Asesmen          @relation(fields: [asesmenId], references: [id])
  pengguna       Pengguna         @relation(fields: [siswaId], references: [id])
  jawabanAsesmen JawabanAsesmen[]
  hasilAsesmen   HasilAsesmen?

  @@map("percobaan_asesmen")
}

model JawabanAsesmen {
  id                 String  @id @default(uuid())
  percobaanAsesmenId String  @map("percobaan_asesmen_id")
  soalId             String  @map("soal_id")
  dibuatOleh         String? @map("dibuat_oleh")
  diperbaruiOleh     String? @map("diperbarui_oleh")
  dihapusOleh        String? @map("dihapus_oleh")

  jawaban     String?  @db.Text
  nilai       Decimal? @db.Decimal(5, 2)
  catatanGuru String?  @map("catatan_guru") @db.Text
  benar       Boolean?

  dibuatPada     DateTime  @default(now()) @map("dibuat_pada") @db.Timestamp()
  diperbaruiPada DateTime  @updatedAt @map("diperbarui_pada") @db.Timestamp()
  dihapusPada    DateTime? @map("dihapus_pada") @db.Timestamp()

  percobaanAsesmen PercobaanAsesmen @relation(fields: [percobaanAsesmenId], references: [id])
  soalAsesmen      SoalAsesmen      @relation(fields: [soalId], references: [id])

  @@map("jawaban_asesmen")
}

model HasilAsesmen {
  id                 String  @id @default(uuid())
  percobaanAsesmenId String  @unique @map("percobaan_asesmen_id")
  dibuatOleh         String? @map("dibuat_oleh")
  diperbaruiOleh     String? @map("diperbarui_oleh")
  dihapusOleh        String? @map("dihapus_oleh")

  totalNilai   Decimal @map("total_nilai") @db.Decimal(5, 2)
  jumlahBenar  Int     @map("jumlah_benar")
  jumlahSalah  Int     @map("jumlah_salah")
  jumlahLewati Int     @map("jumlah_lewati")
  detail       Json?

  dibuatPada     DateTime  @default(now()) @map("dibuat_pada") @db.Timestamp()
  diperbaruiPada DateTime  @updatedAt @map("diperbarui_pada") @db.Timestamp()
  dihapusPada    DateTime? @map("dihapus_pada") @db.Timestamp()

  percobaanAsesmen PercobaanAsesmen @relation(fields: [percobaanAsesmenId], references: [id])

  @@map("hasil_asesmen")
}

model Tugas {
  id             String    @id @default(uuid())
  kelasMapelId   String    @map("kelas_mapel_id")
  dibuatOleh     String?   @map("dibuat_oleh")
  diperbaruiOleh String?   @map("diperbarui_oleh")
  dihapusOleh    String?   @map("dihapus_oleh")
  judul          String    @db.VarChar(100)
  deskripsi      String?   @db.Text
