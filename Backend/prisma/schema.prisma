model MateriPembelajaran {
  id             String  @id @default(uuid())
  kelasMapelId   String  @map("kelas_mapel_id")
  dibuatOleh     String? @map("dibuat_oleh")
  diperbaruiOleh String? @map("diperbarui_oleh")
