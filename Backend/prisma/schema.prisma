  dihapusPada       DateTime?           @map("dihapus_pada") @db.Timestamp(6)
  pembayaran        PembayaranTagihan[]
  kategoriTagihan   KategoriTagihan     @relation(fields: [kategoriTagihanId], references: [id])
  sekolah           Sekolah             @relation(fields: [sekolahId], references: [id])
  siswa             Pengguna            @relation("SiswaTagihan", fields: [siswaId], references: [id])
  tahunAjaran       TahunAjaran         @relation(fields: [tahunAjaranId], references: [id])
  tarifTagihan      TarifTagihan?       @relation(fields: [tarifTagihanId], references: [id])

  @@index([sekolahId, status, jatuhTempo])
  @@index([siswaId])
  @@index([sekolahId, kategoriTagihanId, tahunAjaranId])
  @@map("tagihan")
}

model PembayaranTagihan {
  id               String    @id @default(uuid())
  sekolahId        String    @map("sekolah_id")
  tagihanId        String    @map("tagihan_id")
  siswaId          String    @map("siswa_id")
  akunKasId        String    @map("akun_kas_id")
  penerimaId       String?   @map("penerima_id")
  dibuatOleh       String?   @map("dibuat_oleh")
  diperbaruiOleh   String?   @map("diperbarui_oleh")
  dihapusOleh      String?   @map("dihapus_oleh")
  nomorPembayaran  String    @unique @map("nomor_pembayaran") @db.VarChar(50)
  jumlah           Decimal   @db.Decimal(15, 2)
  metode           String    @db.VarChar(30)
  tanggalBayar     DateTime  @map("tanggal_bayar") @db.Date
  referensi        String?   @db.VarChar(100)
  catatan          String?
  status           String    @default("berhasil") @db.VarChar(20)
  dibatalkanPada   DateTime? @map("dibatalkan_pada") @db.Timestamp(6)
  dibatalkanOleh   String?   @map("dibatalkan_oleh")
  alasanPembatalan String?   @map("alasan_pembatalan")
  dibuatPada       DateTime  @default(now()) @map("dibuat_pada") @db.Timestamp(6)
  diperbaruiPada   DateTime  @updatedAt @map("diperbarui_pada") @db.Timestamp(6)
  dihapusPada      DateTime? @map("dihapus_pada") @db.Timestamp(6)
  akunKas          AkunKas   @relation(fields: [akunKasId], references: [id])
  penerima         Pengguna? @relation("PenerimaPembayaran", fields: [penerimaId], references: [id])
  sekolah          Sekolah   @relation(fields: [sekolahId], references: [id])
  siswa            Pengguna  @relation("SiswaPembayaran", fields: [siswaId], references: [id])
  tagihan          Tagihan   @relation(fields: [tagihanId], references: [id])

  @@index([sekolahId, tanggalBayar])
  @@index([tagihanId])
  @@index([siswaId])
  @@map("pembayaran_tagihan")
}

model TabunganSiswa {
  id             String              @id @default(uuid())
  sekolahId      String              @map("sekolah_id")
  siswaId        String              @map("siswa_id")
  dibuatOleh     String?             @map("dibuat_oleh")
  diperbaruiOleh String?             @map("diperbarui_oleh")
  dihapusOleh    String?             @map("dihapus_oleh")
  saldo          Decimal             @default(0) @db.Decimal(15, 2)
  status         String?             @default("aktif") @db.VarChar(20)
  dibuatPada     DateTime            @default(now()) @map("dibuat_pada") @db.Timestamp(6)
  diperbaruiPada DateTime            @updatedAt @map("diperbarui_pada") @db.Timestamp(6)
  dihapusPada    DateTime?           @map("dihapus_pada") @db.Timestamp(6)
  sekolah        Sekolah             @relation(fields: [sekolahId], references: [id])
  siswa          Pengguna            @relation("SiswaTabungan", fields: [siswaId], references: [id])
  transaksi      TransaksiTabungan[]

  @@unique([sekolahId, siswaId])
  @@map("tabungan_siswa")
}

model TransaksiTabungan {
  id              String        @id @default(uuid())
  sekolahId       String        @map("sekolah_id")
  tabunganSiswaId String        @map("tabungan_siswa_id")
  akunKasId       String        @map("akun_kas_id")
  petugasId       String?       @map("petugas_id")
  dibuatOleh      String?       @map("dibuat_oleh")
  diperbaruiOleh  String?       @map("diperbarui_oleh")
  dihapusOleh     String?       @map("dihapus_oleh")
  nomorTransaksi  String        @unique @map("nomor_transaksi") @db.VarChar(50)
  jenis           String        @db.VarChar(10)
  jumlah          Decimal       @db.Decimal(15, 2)
  saldoSebelum    Decimal       @map("saldo_sebelum") @db.Decimal(15, 2)
  saldoSesudah    Decimal       @map("saldo_sesudah") @db.Decimal(15, 2)
  tanggal         DateTime      @db.Date
  keterangan      String?
  status          String        @default("berhasil") @db.VarChar(20)
  dibuatPada      DateTime      @default(now()) @map("dibuat_pada") @db.Timestamp(6)
  diperbaruiPada  DateTime      @updatedAt @map("diperbarui_pada") @db.Timestamp(6)
  dihapusPada     DateTime?     @map("dihapus_pada") @db.Timestamp(6)
  akunKas         AkunKas       @relation(fields: [akunKasId], references: [id])
  petugas         Pengguna?     @relation("PetugasTabungan", fields: [petugasId], references: [id])
  sekolah         Sekolah       @relation(fields: [sekolahId], references: [id])
  tabunganSiswa   TabunganSiswa @relation(fields: [tabunganSiswaId], references: [id])

  @@index([sekolahId, tanggal])
  @@index([tabunganSiswaId])
  @@map("transaksi_tabungan")
}

model AkunKas {
  id                String              @id @default(uuid())
  sekolahId         String              @map("sekolah_id")
  dibuatOleh        String?             @map("dibuat_oleh")
  diperbaruiOleh    String?             @map("diperbarui_oleh")
  dihapusOleh       String?             @map("dihapus_oleh")
  kode              String              @db.VarChar(20)
  nama              String              @db.VarChar(100)
  tipe              String              @default("kas") @db.VarChar(20)
  saldoAwal         Decimal             @default(0) @map("saldo_awal") @db.Decimal(15, 2)
  status            String?             @default("aktif") @db.VarChar(20)
  dibuatPada        DateTime            @default(now()) @map("dibuat_pada") @db.Timestamp(6)
  diperbaruiPada    DateTime            @updatedAt @map("diperbarui_pada") @db.Timestamp(6)
  dihapusPada       DateTime?           @map("dihapus_pada") @db.Timestamp(6)
  sekolah           Sekolah             @relation(fields: [sekolahId], references: [id])
  jurnal            JurnalKas[]
  pembayaranTagihan PembayaranTagihan[]
  transaksiTabungan TransaksiTabungan[]

  @@unique([sekolahId, kode])
  @@map("akun_kas")
}

model JurnalKas {
  id             String    @id @default(uuid())
  sekolahId      String    @map("sekolah_id")
  akunKasId      String    @map("akun_kas_id")
  dibuatOleh     String?   @map("dibuat_oleh")
  diperbaruiOleh String?   @map("diperbarui_oleh")
  dihapusOleh    String?   @map("dihapus_oleh")
  nomorJurnal    String    @unique @map("nomor_jurnal") @db.VarChar(50)
  tanggal        DateTime  @db.Date
  jenis          String    @db.VarChar(10)
  kategori       String    @db.VarChar(50)
  jumlah         Decimal   @db.Decimal(15, 2)
  keterangan     String?
  sumber         String    @default("manual") @db.VarChar(30)
  sumberId       String?   @map("sumber_id")
  status         String    @default("aktif") @db.VarChar(20)
  dibuatPada     DateTime  @default(now()) @map("dibuat_pada") @db.Timestamp(6)
  diperbaruiPada DateTime  @updatedAt @map("diperbarui_pada") @db.Timestamp(6)
  dihapusPada    DateTime? @map("dihapus_pada") @db.Timestamp(6)
  akunKas        AkunKas   @relation(fields: [akunKasId], references: [id])
  sekolah        Sekolah   @relation(fields: [sekolahId], references: [id])

  @@index([sekolahId, tanggal])
  @@index([akunKasId, status])
  @@index([sumber, sumberId])
  @@map("jurnal_kas")
}

model Jurusan {
  id              String            @id @default(uuid())
  sekolahId       String            @map("sekolah_id")
  kode            String            @db.VarChar(20)
  nama            String            @db.VarChar(100)
  deskripsi       String?
  status          String            @default("aktif") @db.VarChar(20)
  dibuatOleh      String?           @map("dibuat_oleh")
  diperbaruiOleh  String?           @map("diperbarui_oleh")
  dihapusOleh     String?           @map("dihapus_oleh")
  dibuatPada      DateTime          @default(now()) @map("dibuat_pada") @db.Timestamp(6)
  diperbaruiPada  DateTime          @updatedAt @map("diperbarui_pada") @db.Timestamp(6)
  dihapusPada     DateTime?         @map("dihapus_pada") @db.Timestamp(6)
  sekolah         Sekolah           @relation(fields: [sekolahId], references: [id])
  kelas           Kelas[]
  pendaftaranPpdb PendaftaranPpdb[]

  @@unique([sekolahId, kode])
  @@map("jurusan")
}

model PengumumanPpdb {
  id                 String    @id @default(uuid())
  sekolahId          String    @map("sekolah_id")
  judul              String    @db.VarChar(200)
  konten             String
  status             String    @default("draft") @db.VarChar(20)
  dipublikasikanPada DateTime? @map("dipublikasikan_pada") @db.Timestamp(6)
  dibuatOleh         String?   @map("dibuat_oleh")
  diperbaruiOleh     String?   @map("diperbarui_oleh")
  dihapusOleh        String?   @map("dihapus_oleh")
  dibuatPada         DateTime  @default(now()) @map("dibuat_pada") @db.Timestamp(6)
  diperbaruiPada     DateTime  @updatedAt @map("diperbarui_pada") @db.Timestamp(6)
  dihapusPada        DateTime? @map("dihapus_pada") @db.Timestamp(6)
  sekolah            Sekolah   @relation(fields: [sekolahId], references: [id])

  @@index([sekolahId, status, dipublikasikanPada])
  @@map("pengumuman_ppdb")
}

model PengaturanSpmb {
  id                         String   @id @default(uuid())
  sekolahId                  String   @unique @map("sekolah_id")
  pendaftaranDibuka          Boolean  @default(true) @map("pendaftaran_dibuka")
  wajibLokasi                Boolean  @default(true) @map("wajib_lokasi")
  batasiPendaftarSesuaiKuota Boolean  @default(false) @map("batasi_pendaftar_sesuai_kuota")
  rankingTerbuka             Boolean  @default(true) @map("ranking_terbuka")
  kirimEmailKonfirmasi       Boolean  @default(true) @map("kirim_email_konfirmasi")
  dibuatOleh                 String?  @map("dibuat_oleh")
  diperbaruiOleh             String?  @map("diperbarui_oleh")
  dibuatPada                 DateTime @default(now()) @map("dibuat_pada") @db.Timestamp(6)
  diperbaruiPada             DateTime @updatedAt @map("diperbarui_pada") @db.Timestamp(6)
  sekolah                    Sekolah  @relation(fields: [sekolahId], references: [id])

  @@map("pengaturan_spmb")
}

model ReviewPengguna {
  id             String   @id @default(uuid())
  penggunaId     String   @unique @map("pengguna_id")
  rating         Int
  komentar       String
  status         String   @default("menunggu") @db.VarChar(20)
  dibuatPada     DateTime @default(now()) @map("dibuat_pada") @db.Timestamp(6)
  diperbaruiPada DateTime @updatedAt @map("diperbarui_pada") @db.Timestamp(6)
  pengguna       Pengguna @relation(fields: [penggunaId], references: [id], onDelete: Cascade)

  @@index([status, dibuatPada])
  @@map("review_pengguna")
}

